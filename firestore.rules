rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /production_entries/{docId} {
      allow read, write: if true;
    }
    match /quality_entries/{docId} {
      allow read, write: if true;
    }
    match /factory_alerts/{docId} {
      allow read, write: if true;
    }
    match /daily_setups/{docId} {
      allow read, write: if true;
    }
    match /monthly_targets/{docId} {
      allow read, write: if true;
    }
    match /users/{docId} {
      allow read, write: if true;
    }

    // Admin marker can only be read by its owner UID; client-side promotion is forbidden.
    // Core data rules above are still public and must be replaced before production deployment.
    match /admin_users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
