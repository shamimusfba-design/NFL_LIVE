rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. Primitive & Schema Helpers
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isNonEmptyString(val) {
      return val is string && val.size() > 0 && val.size() <= 500;
    }

    function isValidPhysicalFloor(floor) {
      return floor in [
        'Sew-1', 'Sew-2', 'Sew-3', 'Sew-4',
        'Sew 1', 'Sew 2', 'Sew 3', 'Sew 4',
        'SEW_1', 'SEW_2', 'SEW_3', 'SEW_4',
        'Finishing', 'FINISHING',
        'All Floor', 'All', 'ALL'
      ];
    }

    function isValidFloorScope(scope) {
      return scope in [
        'All Floor', 'All', 'ALL',
        'Sew-1', 'Sew-2', 'Sew-3', 'Sew-4',
        'Sew 1', 'Sew 2', 'Sew 3', 'Sew 4',
        'SEW_1', 'SEW_2', 'SEW_3', 'SEW_4',
        'Finishing', 'FINISHING'
      ];
    }

    function isValidRole(role) {
      return role in [
        'ADMIN', 'IE', 'AUDITOR', 'SUPERVISOR',
        'QUALITY', 'PACKING', 'MANAGEMENT', 'TV_VIEWER',
        'PRODUCTION_REPORTER', 'QUALITY_REPORTER',
        'PRODUCTION_MANAGER', 'QUALITY_MANAGER',
        'MECHANIC', 'INPUT_MATERIAL', 'MANAGEMENT_VIEW'
      ];
    }

    function isSameFloor(a, b) {
      return a == b
        || (a in ['Sew-1', 'Sew 1', 'SEW_1'] && b in ['Sew-1', 'Sew 1', 'SEW_1'])
        || (a in ['Sew-2', 'Sew 2', 'SEW_2'] && b in ['Sew-2', 'Sew 2', 'SEW_2'])
        || (a in ['Sew-3', 'Sew 3', 'SEW_3'] && b in ['Sew-3', 'Sew 3', 'SEW_3'])
        || (a in ['Sew-4', 'Sew 4', 'SEW_4'] && b in ['Sew-4', 'Sew 4', 'SEW_4'])
        || (a in ['Finishing', 'FINISHING'] && b in ['Finishing', 'FINISHING']);
    }

    function hasNoPlaintextPassword(data) {
      return data.get('password', '') == '';
    }

    function getUserAssignedFloor(data) {
      let af = data.get('assignedFloor', '');
      let sc = data.get('authorizedFloorScope', '');
      return af != '' ? af : (sc != '' ? sc : data.get('floor', 'ALL'));
    }

    // =========================================================================
    // 2. Identity & RBAC Resolution (Supports both Firebase Auth & Employee ID mode)
    // =========================================================================
    function authBindingPath() {
      return /databases/$(database)/documents/auth_bindings/$(request.auth.uid);
    }

    function hasAuthBinding() {
      return isSignedIn() && exists(authBindingPath());
    }

    function boundEmployeeId() {
      return get(authBindingPath()).data.get('employeeId', '');
    }

    function userDocPath(empId) {
      return /databases/$(database)/documents/users/$(empId);
    }

    function hasBoundUserDoc() {
      let empId = boundEmployeeId();
      return isSignedIn()
        && exists(authBindingPath())
        && empId != ''
        && exists(/databases/$(database)/documents/users/$(empId));
    }

    function callerUser() {
      return get(/databases/$(database)/documents/users/$(boundEmployeeId())).data;
    }

    // Allows Employee ID mode (when request.auth == null or not yet bound) OR approved bound user
    function isAuthorizedOrEmployeeIdClient() {
      return !isSignedIn()
        || !hasBoundUserDoc()
        || callerUser().get('accountStatus', 'APPROVED') == 'APPROVED';
    }

    function isAdmin() {
      let empId = boundEmployeeId();
      let authEmail = request.auth != null ? request.auth.token.get('email', '') : '';
      return !isSignedIn() || (
        authEmail in ['shamim.usfba@gmail.com', 'shamim.sustipe15@gmail.com']
        || (
          exists(authBindingPath())
          && empId != ''
          && exists(/databases/$(database)/documents/users/$(empId))
          && get(/databases/$(database)/documents/users/$(empId)).data.get('accountStatus', '') == 'APPROVED'
          && (
            get(/databases/$(database)/documents/users/$(empId)).data.get('role', '') == 'ADMIN'
            || empId == '1015198'
          )
        )
      );
    }

    function callerHasFloorAccess(targetFloor) {
      return !isSignedIn()
        || !hasBoundUserDoc()
        || callerUser().get('role', '') in ['ADMIN', 'IE', 'AUDITOR', 'PRODUCTION_MANAGER', 'QUALITY_MANAGER', 'MANAGEMENT', 'MANAGEMENT_VIEW']
        || boundEmployeeId() == '1015198'
        || getUserAssignedFloor(callerUser()) in ['All Floor', 'All', 'ALL']
        || isSameFloor(getUserAssignedFloor(callerUser()), targetFloor);
    }

    function hasValidOutputQty(data) {
      let q = data.get('outputQty', data.get('outputPcs', 0));
      return q is number && q >= 0;
    }

    function hasValidCheckedGarments(data) {
      let c = data.get('checkedGarments', data.get('checkedPcs', 0));
      return c is number && c >= 0;
    }

    // =========================================================================
    // 3. Collection Rules
    // =========================================================================

    match /auth_bindings/{uid} {
      allow read: if true;
      allow create, update: if isNonEmptyString(request.resource.data.get('employeeId', ''));
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    match /users/{userId} {
      // Allow reading user accounts for Employee ID / Email sign-in on Web, Android, and Smart TV
      allow read: if true;

      allow create: if isNonEmptyString(request.resource.data.get('name', userId))
        && isValidRole(request.resource.data.get('role', 'ADMIN'))
        && hasNoPlaintextPassword(request.resource.data)
        && (
          !isSignedIn()
          || (
            request.resource.data.get('accountStatus', '') == 'PENDING_APPROVAL'
            && request.resource.data.get('role', '') != 'ADMIN'
            && request.resource.data.get('isAdmin', false) == false
          )
          || (
            userId in ['1015198', 'shamim.usfba@gmail.com', 'shamim.sustipe15@gmail.com']
            && request.resource.data.get('role', '') == 'ADMIN'
            && request.resource.data.get('accountStatus', '') == 'APPROVED'
          )
          || isAdmin()
        );

      allow update: if hasNoPlaintextPassword(request.resource.data)
        && (
          !(userId in ['1015198', 'shamim.usfba@gmail.com', 'shamim.sustipe15@gmail.com'])
          || (request.resource.data.get('role', 'ADMIN') == 'ADMIN' && request.resource.data.get('accountStatus', 'APPROVED') == 'APPROVED')
        )
        && (
          !isSignedIn()
          || isAdmin()
          || (
            request.resource.data.get('role', '') == resource.data.get('role', '')
            && request.resource.data.get('accountStatus', '') == resource.data.get('accountStatus', '')
            && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
          )
        );

      allow delete: if isAdmin() && !(userId in ['1015198', 'shamim.usfba@gmail.com', 'shamim.sustipe15@gmail.com']);
    }

    match /production_entries/{docId} {
      allow read: if true;
      allow create, update: if isAuthorizedOrEmployeeIdClient()
        && callerHasFloorAccess(request.resource.data.get('floor', 'ALL'))
        && isNonEmptyString(request.resource.data.get('lineId', ''))
        && isValidPhysicalFloor(request.resource.data.get('floor', ''))
        && isNonEmptyString(request.resource.data.get('date', ''))
        && isNonEmptyString(request.resource.data.get('hourSlot', ''))
        && hasValidOutputQty(request.resource.data);
      allow delete: if isAdmin();
    }

    match /quality_entries/{docId} {
      allow read: if true;
      allow create, update: if isAuthorizedOrEmployeeIdClient()
        && callerHasFloorAccess(request.resource.data.get('floor', 'ALL'))
        && isNonEmptyString(request.resource.data.get('lineId', ''))
        && isValidPhysicalFloor(request.resource.data.get('floor', ''))
        && isNonEmptyString(request.resource.data.get('date', ''))
        && isNonEmptyString(request.resource.data.get('hourSlot', ''))
        && hasValidCheckedGarments(request.resource.data);
      allow delete: if isAdmin();
    }

    match /factory_alerts/{docId} {
      allow read: if true;
      allow create, update: if isAuthorizedOrEmployeeIdClient()
        && callerHasFloorAccess(request.resource.data.get('floor', 'ALL'))
        && isNonEmptyString(request.resource.data.get('lineId', ''));
      allow delete: if isAdmin();
    }

    match /daily_setups/{docId} {
      allow read: if true;
      allow create, update: if isAuthorizedOrEmployeeIdClient()
        && callerHasFloorAccess(request.resource.data.get('floor', 'ALL'))
        && isNonEmptyString(request.resource.data.get('lineId', ''))
        && isNonEmptyString(request.resource.data.get('date', ''));
      allow delete: if isAdmin();
    }

    match /monthly_targets/{docId} {
      allow read: if true;
      allow create, update: if isAuthorizedOrEmployeeIdClient();
      allow delete: if isAdmin();
    }

    match /weekly_quality/{weekKey} {
      allow read: if true;
      allow create, update: if isAuthorizedOrEmployeeIdClient();
      allow delete: if isAdmin();
    }

    match /registration_requests/{requestId} {
      allow read: if true;
      allow create, update: if isNonEmptyString(request.resource.data.get('employeeId', ''));
      allow delete: if isAdmin();
    }

    match /device_approval_requests/{requestId} {
      allow read: if true;
      allow create, update: if isNonEmptyString(request.resource.data.get('deviceId', ''));
      allow delete: if isAdmin();
    }

    match /admin_notifications/{notificationId} {
      allow read: if true;
      allow create, update: if isNonEmptyString(request.resource.data.get('requestId', ''));
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
